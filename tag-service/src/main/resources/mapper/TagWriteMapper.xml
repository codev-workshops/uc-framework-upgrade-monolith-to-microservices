<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.spring.infrastructure.mybatis.mapper.TagWriteMapper">
    <select id="findByName" resultType="io.spring.core.article.Tag">
        select id, name from tags where name = #{name}
    </select>

    <insert id="insertTag">
        insert into tags (id, name) values (#{tag.id}, #{tag.name})
    </insert>

    <insert id="insertArticleTag">
        insert into article_tags (article_id, tag_id) values (#{articleId}, #{tagId})
    </insert>

    <delete id="deleteArticleTags">
        delete from article_tags where article_id = #{articleId}
    </delete>
</mapper>
