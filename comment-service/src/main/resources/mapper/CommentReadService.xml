<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.spring.commentservice.infrastructure.mybatis.readservice.CommentReadService">
    <sql id="selectComment">
        select
        C.id commentId,
        C.body commentBody,
        C.article_id commentArticleId,
        C.created_at commentCreatedAt,
        U.id visitorId,
        U.username visitorUsername,
        U.bio visitorBio,
        U.image visitorImage
        from comments C
        left join users U on C.user_id = U.id
    </sql>

    <select id="findById" resultMap="commentData">
        <include refid="selectComment"/>
        where C.id = #{id}
    </select>

    <select id="findByArticleId" resultMap="commentData">
        <include refid="selectComment"/>
        where C.article_id = #{articleId}
        order by C.created_at desc
    </select>

    <resultMap id="profileData" type="io.spring.common.dto.ProfileData">
        <id column="visitorId" property="id"/>
        <result column="visitorUsername" property="username"/>
        <result column="visitorBio" property="bio"/>
        <result column="visitorImage" property="image"/>
    </resultMap>

    <resultMap id="commentData" type="io.spring.commentservice.application.data.CommentData">
        <id column="commentId" property="id"/>
        <result column="commentBody" property="body"/>
        <result column="commentArticleId" property="articleId"/>
        <result column="commentCreatedAt" property="createdAt"/>
        <association property="profileData" resultMap="profileData"/>
    </resultMap>
</mapper>
